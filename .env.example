# Incheon Mobility Project Management Platform Environment Configuration

# Database Connection (SQLite by default for local development)
DATABASE_URL="file:./dev.db"

# Production PostgreSQL example (AWS RDS, Supabase, Azure):
# DATABASE_URL="postgresql://user:password@host:5432/incheon_projman?schema=public"

# App Port (defaults to 3001 if 3000 is occupied)
PORT=3001

# Node Environment
NODE_ENV="development"
