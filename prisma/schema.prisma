datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String    @unique
  color     String?   @default("#0EA5E9") // Brand accent color
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@map("projman_brands")
}

model Location {
  id        String    @id @default(cuid())
  name      String    @unique
  district  String?
  state     String    @default("Kerala")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@map("projman_locations")
}

model Project {
  id                 String     @id @default(cuid())
  code               String     @unique // e.g. RIV-PAL-01
  brandId            String
  brand              Brand      @relation(fields: [brandId], references: [id])
  locationId         String
  location           Location   @relation(fields: [locationId], references: [id])
  facilityType       String     // "Sales", "Service", "Stock Yard", "Sales & Service"
  currentStatus      String     // "Commissioned", "Ready for Handover", "BOQ Approved / PO Pending", "Pre-Construction", "Commercial Negotiation"
  scheduleHealth     String     // "Completed", "On Track", "Watchlist", "Delayed (>30d)", "Action Needed"
  workPercentage     Float      @default(0) // 0 to 100
  fixedTargetDate    DateTime   @default("2027-03-31T00:00:00.000Z")
  startDate          DateTime?
  commissionedDate   DateTime?
  elapsedDays        Int        @default(0)
  daysToTarget       Int        @default(131)
  daysSinceLastMilestone Int    @default(0)
  keyRemarks         String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  milestones         Milestone[]
  blockers           Blocker[]
  auditLogs          AuditLog[]

  @@map("projman_projects")
}

model Milestone {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseNumber    Int       // 1: Property & Agreement, 2: Design & GFC, 3: BOQ & PO, 4: Site Execution & Handover
  phaseName      String    // e.g. "Property & Agreement"
  stepKey        String    // canonical identifier
  title          String    // human readable milestone title
  orderIndex     Int
  status         String    @default("Pending") // "Pending", "In Progress", "Completed", "Awaiting"
  plannedDate    DateTime?
  actualDate     DateTime?
  benchmarkDays  Int?      // standard benchmark
  elapsedDays    Int?      // actual duration
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  blockers       Blocker[]

  @@map("projman_milestones")
}

model Blocker {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  category    String     // "Landlord", "River OEM", "Municipal / Legal", "Civil Contractor", "Internal Management"
  severity    String     // "Critical", "Major", "Moderate", "Minor"
  title       String
  description String
  status      String     @default("Open") // "Open", "Under Discussion", "Resolved"
  loggedAt    DateTime   @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("projman_blockers")
}

model AuditLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userRole  String   // "Admin", "User", "Manager"
  action    String   // "UPDATE_STATUS", "UPDATE_MILESTONE", "CREATE_PROJECT", "LOG_BLOCKER"
  details   String
  timestamp DateTime @default(now())

  @@map("projman_audit_logs")
}

model Benchmark {
  id          String   @id @default(cuid())
  stageNumber Int      @unique
  stageName   String   // e.g. "1. Property Approval"
  avgDays     Float
  minDays     Int
  maxDays     Int
  tracksCount Int
  updatedAt   DateTime @updatedAt

  @@map("projman_benchmarks")
}
